+  [
+    "portfolio",
+    read("app/api/portfolio-videos/route.ts"),
+    ["control.portfolio"],
+  ],
+  [
+    "marketing tracking",
+    read("app/api/marketing/events/route.ts"),
+    [
+      "control.marketingTracking",
+      "durableRateLimit",
+    ],
+  ],
+  [
