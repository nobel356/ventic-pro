generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum UserRole {
  SUPER_ADMIN
  ADMIN
  CUSTOMER_SERVICE
  TECHNICIAN
}
enum OrderStatus {
  NEW
  CONFIRMED
  ASSIGNED
  ON_THE_WAY
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
enum SpaceType {
  BATHROOM
  KITCHEN
}
enum AttachmentKind {
  CUSTOMER
  BEFORE
  AFTER
}
model User {
  id String @id @default(cuid())
  name String
  email String @unique
  phone String?
  passwordHash String?
  role UserRole
  active Boolean @default(true)
  permissions String[] @default([])
  createdAt DateTime @default(now())
  assignedOrders Order[] @relation("AssignedTechnician")
  auditLogs AuditLog[]
  sessions Session[]
  requestedExtraCharges ExtraCharge[]
  receivedPayments Payment[]
  maintenanceAssignments MaintenanceRequest[]
  complaintAssignments Complaint[]
  technicianSlots TechnicianSlot[]
  technicianReviews Review[]
  inventoryMovements InventoryMovement[]
  receivedPurchases PurchaseReceipt[] @relation("PurchaseReceivedBy")
  createdStocktakes Stocktake[] @relation("StocktakeCreatedBy")
  approvedStocktakes Stocktake[] @relation("StocktakeApprovedBy")
  countedStocktakes Stocktake[] @relation("StocktakeTechnician")
  adminNotifications AdminNotification[]
}
model Customer {
  id String @id @default(cuid())
  name String
  phone String @unique
  passwordHash String?
  active Boolean @default(true)
  orders Order[]
  properties Property[]
  notifications Notification[]
  sessions CustomerSession[]
  passwordResets CustomerPasswordReset[]
  createdAt DateTime @default(now())
}
model Order {
  id String @id @default(cuid())
  orderNo String @unique
  customerId String
  customer Customer @relation(fields:[customerId],references:[id])
  propertyId String?
  property Property? @relation(fields:[propertyId],references:[id],onDelete:SetNull)
  status OrderStatus @default(NEW)
  estimatedTotal Decimal? @db.Decimal(10,2)
  finalTotal Decimal? @db.Decimal(10,2)
  governorate String?
  area String?
  address String?
  preferredDate String?
  preferredTime String?
  estimateAccepted Boolean @default(false)
  technicianId String?
  technician User? @relation("AssignedTechnician",fields:[technicianId],references:[id])
  completionOtpHash String?
  completionOtpExpiresAt DateTime?
  spaces Space[]
  attachments Attachment[]
  auditLogs AuditLog[]
  quotes Quote[]
  venticEstimates VenticEstimate[]
  extraCharges ExtraCharge[]
  payments Payment[]
  invoice Invoice?
  warranties Warranty[]
  maintenanceRequests MaintenanceRequest[]
  complaints Complaint[]
  technicianSlots TechnicianSlot[]
  review Review?
  inventoryMovements InventoryMovement[]
  installedDevices Device[] @relation("InstalledDevices")
  convertedLead Lead?
  notifications Notification[]
  adminNotifications AdminNotification[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Space {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  type SpaceType
  label String
  details Json?
  services OrderService[]
}
model Service {
  id String @id @default(cuid())
  code String @unique
  nameAr String
  active Boolean @default(true)
  pricingType String @default("FIXED")
  priceFrom Decimal @db.Decimal(10,2)
  priceTo Decimal? @db.Decimal(10,2)
  customerVisible Boolean @default(true)
  orderServices OrderService[]
  updatedAt DateTime @updatedAt
}
model OrderService {
  id String @id @default(cuid())
  spaceId String
  serviceId String?
  space Space @relation(fields:[spaceId],references:[id],onDelete:Cascade)
  service Service? @relation(fields:[serviceId],references:[id])
  serviceCodeSnapshot String
  serviceNameSnapshot String
  qty Decimal @default(1) @db.Decimal(10,2)
  unitPriceSnapshot Decimal @db.Decimal(10,2)
}
model Attachment {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  kind AttachmentKind
  fileName String
  mimeType String
  storagePath String
  uploadedBy String?
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(cuid())
  orderId String?
  order Order? @relation(fields:[orderId],references:[id],onDelete:SetNull)
  actorId String?
  actor User? @relation(fields:[actorId],references:[id],onDelete:SetNull)
  actorLabel String
  action String
  oldValue Json?
  newValue Json?
  createdAt DateTime @default(now())
}


enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum ExtraChargeStatus {
  PENDING
  APPROVED
  REJECTED
}

model Quote {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount Decimal @db.Decimal(10,2)
  notes String?
  status QuoteStatus @default(DRAFT)
  customerToken String @unique
  sentAt DateTime?
  respondedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum VenticEstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  SUPERSEDED
}

model VenticEstimate {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  version Int
  status VenticEstimateStatus @default(DRAFT)
  subtotal Decimal @default(0) @db.Decimal(10,2)
  discount Decimal @default(0) @db.Decimal(10,2)
  total Decimal @default(0) @db.Decimal(10,2)
  notes String?
  customerToken String @unique
  sentAt DateTime?
  respondedAt DateTime?
  items VenticEstimateItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, version])
  @@index([orderId, status])
}

model VenticEstimateItem {
  id String @id @default(cuid())
  estimateId String
  estimate VenticEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  description String
  unit String @default("وحدة")
  qty Decimal @default(1) @db.Decimal(10,2)
  unitPrice Decimal @default(0) @db.Decimal(10,2)
  sortOrder Int @default(0)

  @@index([estimateId])
}

model ExtraCharge {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title String
  reason String
  amount Decimal @db.Decimal(10,2)
  status ExtraChargeStatus @default(PENDING)
  customerToken String @unique
  requestedById String?
  requestedBy User? @relation(fields: [requestedById], references: [id])
  respondedAt DateTime?
  createdAt DateTime @default(now())
}

model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}


model CustomerSession {
  id String @id @default(cuid())
  tokenHash String @unique
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([customerId, expiresAt])
}


model CustomerPasswordReset {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  codeHash String
  expiresAt DateTime
  attempts Int @default(0)
  usedAt DateTime?
  createdAt DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([expiresAt, usedAt])
}


enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  WALLET
  OTHER
}
enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  PARTIAL
}
enum TicketStatus {
  OPEN
  SCHEDULED
  IN_PROGRESS
  RESOLVED
  CLOSED
}
enum AftercareCostType {
  WARRANTY
  FREE
  PAID
}
enum WarrantyStatus {
  ACTIVE
  EXPIRED
  VOID
}

model Payment {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  amount Decimal @db.Decimal(10,2)
  method PaymentMethod
  status PaymentStatus @default(PAID)
  reference String?
  receivedById String?
  receivedBy User? @relation(fields:[receivedById],references:[id])
  createdAt DateTime @default(now())
}

model Invoice {
  id String @id @default(cuid())
  invoiceNo String @unique
  orderId String @unique
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  subtotal Decimal @db.Decimal(10,2)
  discount Decimal @default(0) @db.Decimal(10,2)
  total Decimal @db.Decimal(10,2)
  paid Decimal @default(0) @db.Decimal(10,2)
  due Decimal @default(0) @db.Decimal(10,2)
  issuedAt DateTime @default(now())
}

model Warranty {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  startsAt DateTime
  endsAt DateTime
  status WarrantyStatus @default(ACTIVE)
  notes String?
  maintenanceRequests MaintenanceRequest[]
  createdAt DateTime @default(now())
}

model MaintenanceRequest {
  id String @id @default(cuid())
  warrantyId String?
  warranty Warranty? @relation(fields:[warrantyId],references:[id])
  orderId String
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  propertyId String?
  property Property? @relation(fields:[propertyId],references:[id],onDelete:SetNull)
  deviceId String?
  device Device? @relation(fields:[deviceId],references:[id],onDelete:SetNull)
  issue String
  status TicketStatus @default(OPEN)
  costType AftercareCostType @default(WARRANTY)
  chargeAmount Decimal @default(0) @db.Decimal(10,2)
  appointmentAt DateTime?
  technicianId String?
  technician User? @relation(fields:[technicianId],references:[id])
  createdByCustomer Boolean @default(false)
  resolution String?
  closedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId,status])
  @@index([propertyId])
  @@index([deviceId])
}

model Complaint {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  propertyId String?
  property Property? @relation(fields:[propertyId],references:[id],onDelete:SetNull)
  deviceId String?
  device Device? @relation(fields:[deviceId],references:[id],onDelete:SetNull)
  issue String
  status TicketStatus @default(OPEN)
  freeRevisit Boolean @default(false)
  costType AftercareCostType @default(FREE)
  chargeAmount Decimal @default(0) @db.Decimal(10,2)
  revisitAt DateTime?
  technicianId String?
  technician User? @relation(fields:[technicianId],references:[id])
  createdByCustomer Boolean @default(false)
  resolution String?
  closedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId,status])
  @@index([propertyId])
  @@index([deviceId])
}

model TechnicianSlot {
  id String @id @default(cuid())
  technicianId String
  technician User @relation(fields:[technicianId],references:[id],onDelete:Cascade)
  orderId String?
  order Order? @relation(fields:[orderId],references:[id],onDelete:SetNull)
  sourceType String?
  sourceId String?
  startsAt DateTime
  endsAt DateTime
  createdAt DateTime @default(now())

  @@index([technicianId,startsAt,endsAt])
  @@index([sourceType,sourceId])
}


enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
}
enum DiscountType {
  FIXED
  PERCENT
}

enum PurchaseStatus {
  RECEIVED
  VOID
}

enum StocktakeStatus {
  DRAFT
  APPROVED
}

enum StocktakeLocationType {
  COMPANY
  TECHNICIAN
}

model Review {
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  technicianId String?
  technician User? @relation(fields:[technicianId],references:[id])
  overall Int
  punctuality Int
  professionalism Int
  installationQuality Int
  cleanliness Int
  communication Int
  valueForMoney Int
  arrivalNote String?
  comment String?
  createdAt DateTime @default(now())
}

model InventoryItem {
  id String @id @default(cuid())
  sku String @unique
  nameAr String
  unit String
  quantity Decimal @default(0) @db.Decimal(12,2)
  reorderLevel Decimal @default(0) @db.Decimal(12,2)
  lastUnitCost Decimal @default(0) @db.Decimal(12,2)
  averageUnitCost Decimal @default(0) @db.Decimal(12,2)
  active Boolean @default(true)
  movements InventoryMovement[]
  purchaseItems PurchaseReceiptItem[]
  stocktakeLines StocktakeLine[]
  createdAt DateTime @default(now())
}

model InventoryMovement {
  id String @id @default(cuid())
  itemId String
  item InventoryItem @relation(fields:[itemId],references:[id],onDelete:Cascade)
  type InventoryMovementType
  quantity Decimal @db.Decimal(12,2)
  orderId String?
  order Order? @relation(fields:[orderId],references:[id],onDelete:SetNull)
  technicianId String?
  technician User? @relation(fields:[technicianId],references:[id])
  purchaseReceiptId String?
  purchaseReceipt PurchaseReceipt? @relation(fields:[purchaseReceiptId],references:[id],onDelete:SetNull)
  stocktakeId String?
  stocktake Stocktake? @relation(fields:[stocktakeId],references:[id],onDelete:SetNull)
  note String?
  createdAt DateTime @default(now())

  @@index([purchaseReceiptId])
  @@index([stocktakeId])
}

model Supplier {
  id String @id @default(cuid())
  name String
  phone String?
  address String?
  taxNumber String?
  notes String?
  active Boolean @default(true)
  purchases PurchaseReceipt[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseReceipt {
  id String @id @default(cuid())
  receiptNo String @unique
  supplierId String
  supplier Supplier @relation(fields:[supplierId],references:[id])
  supplierInvoiceNo String?
  status PurchaseStatus @default(RECEIVED)
  total Decimal @default(0) @db.Decimal(12,2)
  receivedById String?
  receivedBy User? @relation("PurchaseReceivedBy",fields:[receivedById],references:[id],onDelete:SetNull)
  receivedAt DateTime @default(now())
  notes String?
  items PurchaseReceiptItem[]
  movements InventoryMovement[]
  createdAt DateTime @default(now())

  @@index([supplierId,receivedAt])
}

model PurchaseReceiptItem {
  id String @id @default(cuid())
  purchaseReceiptId String
  purchaseReceipt PurchaseReceipt @relation(fields:[purchaseReceiptId],references:[id],onDelete:Cascade)
  itemId String
  item InventoryItem @relation(fields:[itemId],references:[id])
  quantity Decimal @db.Decimal(12,2)
  unitCost Decimal @db.Decimal(12,2)
  lineTotal Decimal @db.Decimal(12,2)

  @@index([purchaseReceiptId])
  @@index([itemId])
}

model Stocktake {
  id String @id @default(cuid())
  stocktakeNo String @unique
  status StocktakeStatus @default(DRAFT)
  locationType StocktakeLocationType @default(COMPANY)
  technicianId String?
  technician User? @relation("StocktakeTechnician",fields:[technicianId],references:[id],onDelete:SetNull)
  createdById String?
  createdBy User? @relation("StocktakeCreatedBy",fields:[createdById],references:[id],onDelete:SetNull)
  approvedById String?
  approvedBy User? @relation("StocktakeApprovedBy",fields:[approvedById],references:[id],onDelete:SetNull)
  notes String?
  lines StocktakeLine[]
  movements InventoryMovement[]
  approvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status,createdAt])
  @@index([technicianId])
}

model StocktakeLine {
  id String @id @default(cuid())
  stocktakeId String
  stocktake Stocktake @relation(fields:[stocktakeId],references:[id],onDelete:Cascade)
  itemId String
  item InventoryItem @relation(fields:[itemId],references:[id])
  expectedQty Decimal @db.Decimal(12,2)
  actualQty Decimal? @db.Decimal(12,2)
  difference Decimal? @db.Decimal(12,2)
  note String?

  @@unique([stocktakeId,itemId])
}

model ServiceArea {
  id String @id @default(cuid())
  governorate String
  area String
  travelFee Decimal @default(0) @db.Decimal(10,2)
  active Boolean @default(true)
  serviceDays String?
  @@unique([governorate,area])
}

model Coupon {
  id String @id @default(cuid())
  code String @unique
  type DiscountType
  value Decimal @db.Decimal(10,2)
  minOrder Decimal? @db.Decimal(10,2)
  startsAt DateTime?
  endsAt DateTime?
  maxUses Int?
  usedCount Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
}


enum LeadStatus {
  STARTED
  CONTACTED
  CONVERTED
  ABANDONED
}
enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
  IN_APP
}
enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

model Property {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields:[customerId],references:[id],onDelete:Cascade)
  label String?
  governorate String
  area String
  address String
  building String?
  floor String?
  apartment String?
  orders Order[]
  devices Device[]
  maintenanceRequests MaintenanceRequest[]
  complaints Complaint[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

model Device {
  id String @id @default(cuid())
  propertyId String
  property Property @relation(fields:[propertyId],references:[id],onDelete:Cascade)
  sourceOrderId String?
  sourceOrder Order? @relation("InstalledDevices",fields:[sourceOrderId],references:[id],onDelete:SetNull)
  type String
  serviceCode String?
  serviceName String?
  brand String?
  model String?
  size String?
  location String?
  installedAt DateTime?
  warrantyEndsAt DateTime?
  notes String?
  active Boolean @default(true)
  maintenanceRequests MaintenanceRequest[]
  complaints Complaint[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([sourceOrderId])
}

model Lead {
  id String @id @default(cuid())
  phone String?
  name String?
  source String?
  status LeadStatus @default(STARTED)
  currentStep Int @default(1)
  payload Json?
  consentToFollowUp Boolean @default(false)
  convertedOrderId String? @unique
  convertedOrder Order? @relation(fields:[convertedOrderId],references:[id])
  lastActivityAt DateTime @default(now())
  createdAt DateTime @default(now())
}

model Notification {
  id String @id @default(cuid())
  orderId String?
  order Order? @relation(fields:[orderId],references:[id],onDelete:SetNull)
  customerId String?
  customer Customer? @relation(fields:[customerId],references:[id],onDelete:SetNull)
  channel NotificationChannel
  templateKey String
  destinationMasked String?
  payload Json?
  status NotificationStatus @default(QUEUED)
  providerMessageId String?
  error String?
  sentAt DateTime?
  createdAt DateTime @default(now())
}

enum AdminNotificationType {
  NEW_ORDER
  ORDER_STATUS
  TECHNICIAN_ASSIGNMENT
  ORDER_COMPLETED
  PAYMENT
  QUOTATION_RESPONSE
  EXTRA_CHARGE_RESPONSE
  MAINTENANCE_REQUEST
  COMPLAINT
  OTP_ALERT
  ORDER_STALE
  SYSTEM
}

model AdminNotification {
  id String @id @default(cuid())
  recipientId String
  recipient User @relation(fields:[recipientId], references:[id], onDelete:Cascade)
  orderId String?
  order Order? @relation(fields:[orderId], references:[id], onDelete:SetNull)
  type AdminNotificationType
  title String
  message String
  href String?
  dedupeKey String?
  isRead Boolean @default(false)
  readAt DateTime?
  createdAt DateTime @default(now())

  @@index([recipientId,dedupeKey])
  @@index([recipientId,isRead,createdAt])
  @@index([orderId])
}
